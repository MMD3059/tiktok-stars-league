{
  "installCommand": "npm ci --prefer-offline && cd server && npm ci --prefer-offline && cd ../client && npm ci --prefer-offline",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/teams",
      "schedule": "*/10 * * * *"
    }
  ]
}
